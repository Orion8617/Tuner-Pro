@charset "utf-8";

*, ::before, ::after { box-sizing: border-box; margin: 0px; padding: 0px; }

body { background: rgb(6, 8, 10); color: rgb(200, 208, 216); font-family: "Courier New", monospace; min-height: 100vh; display: flex; flex-direction: column; }

header { display: flex; align-items: center; justify-content: space-between; padding: 18px 32px; border-bottom: 1px solid rgb(30, 48, 64); background: rgb(6, 10, 14); }

header .logo-block { display: flex; flex-direction: column; gap: 2px; }

header .logo-block .chip-id { font-size: 22px; font-weight: bold; letter-spacing: 0.2em; color: rgb(0, 204, 255); text-shadow: rgba(0, 204, 255, 0.4) 0px 0px 14px; }

header .logo-block .chip-sub { font-size: 9px; letter-spacing: 0.3em; color: rgba(255, 255, 255, 0.19); text-transform: uppercase; }

header .header-meta { text-align: right; font-size: 9px; letter-spacing: 0.15em; color: rgba(255, 255, 255, 0.145); text-transform: uppercase; line-height: 1.8; }

header .header-meta span { display: block; color: rgba(0, 204, 255, 0.333); }

.page-body { flex: 1 1 0%; display: grid; grid-template-columns: 1fr 320px; gap: 0px; }

.chip-panel { padding: 24px; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; border-right: 1px solid rgb(26, 42, 54); }

.chip-label { font-size: 8px; letter-spacing: 0.25em; color: rgba(255, 255, 255, 0.145); text-transform: uppercase; margin-bottom: 12px; align-self: flex-start; }

.chip-img-wrapper { position: relative; width: 100%; max-width: 620px; border: 1px solid rgb(30, 48, 64); background: rgb(8, 12, 16); }

.chip-img-wrapper img { width: 100%; display: block; filter: saturate(1.05) contrast(1.05); }

.scan-line { position: absolute; top: 0px; left: 0px; right: 0px; height: 2px; background: linear-gradient(90deg, transparent 0%, rgba(0, 204, 255, 0.133) 40%, rgba(0, 204, 255, 0.333) 50%, rgba(0, 204, 255, 0.133) 60%, transparent 100%); animation: 6s linear 0s infinite normal none running scan; pointer-events: none; }

@keyframes scan { 
  0% { top: 0%; opacity: 0; }
  5% { opacity: 1; }
  95% { opacity: 1; }
  100% { top: 100%; opacity: 0; }
}

.chip-note { margin-top: 10px; font-size: 9px; letter-spacing: 0.1em; color: rgba(255, 255, 255, 0.094); align-self: flex-start; }

.specs-panel { padding: 24px 20px; display: flex; flex-direction: column; gap: 20px; overflow-y: auto; }

.spec-group { display: flex; flex-direction: column; gap: 6px; }

.spec-group-title { font-size: 8px; letter-spacing: 0.3em; color: rgba(0, 204, 255, 0.4); text-transform: uppercase; border-bottom: 1px solid rgb(26, 42, 54); padding-bottom: 4px; margin-bottom: 2px; }

.spec-row { display: flex; justify-content: space-between; align-items: flex-start; font-size: 10px; line-height: 1.5; }

.spec-key { color: rgba(255, 255, 255, 0.208); letter-spacing: 0.08em; flex: 1 1 0%; }

.spec-val { color: rgb(0, 204, 255); letter-spacing: 0.06em; text-align: right; flex: 1 1 0%; font-weight: bold; }

.spec-val.green { color: rgb(0, 255, 170); }

.spec-val.amber { color: rgb(255, 187, 0); }

.spec-val.violet { color: rgb(204, 136, 255); }

.spec-val.white { color: rgb(224, 232, 240); }

.bar-row { display: flex; flex-direction: column; gap: 3px; margin-top: 2px; }

.bar-label { display: flex; justify-content: space-between; font-size: 9px; color: rgba(255, 255, 255, 0.19); }

.bar-track { height: 4px; background: rgb(13, 24, 32); border-radius: 2px; overflow: hidden; }

.bar-fill { height: 100%; border-radius: 2px; animation: 1.5s ease-out 0s 1 normal forwards running fillIn; transform-origin: left center; }

@keyframes fillIn { 
  0% { width: 0%; }
}

.bar-fill.cyan { background: linear-gradient(90deg, rgb(0, 102, 136), rgb(0, 204, 255)); }

.bar-fill.green { background: linear-gradient(90deg, rgb(0, 102, 68), rgb(0, 255, 170)); }

.bar-fill.amber { background: linear-gradient(90deg, rgb(102, 68, 0), rgb(255, 187, 0)); }

.bar-fill.violet { background: linear-gradient(90deg, rgb(68, 0, 102), rgb(204, 136, 255)); }

.hemi-row { display: flex; gap: 10px; margin-top: 4px; }

.hemi-block { flex: 1 1 0%; padding: 8px; border: 1px solid rgb(26, 42, 54); background: rgb(9, 14, 20); display: flex; flex-direction: column; gap: 3px; align-items: center; }

.hemi-title { font-size: 8px; letter-spacing: 0.2em; color: rgba(255, 255, 255, 0.19); text-transform: uppercase; }

.hemi-value { font-size: 18px; font-weight: bold; color: rgb(0, 204, 255); text-shadow: rgba(0, 204, 255, 0.333) 0px 0px 12px; }

.hemi-desc { font-size: 8px; color: rgba(255, 255, 255, 0.145); }

.isa-list { display: flex; flex-direction: column; gap: 4px; margin-top: 2px; }

.isa-item { font-size: 9px; padding: 4px 8px; border-left: 2px solid rgba(0, 204, 255, 0.267); background: rgb(10, 21, 32); color: rgb(192, 208, 220); letter-spacing: 0.08em; }

footer { padding: 12px 32px; border-top: 1px solid rgb(26, 42, 54); display: flex; justify-content: space-between; align-items: center; font-size: 8px; letter-spacing: 0.15em; color: rgba(255, 255, 255, 0.125); text-transform: uppercase; }

footer span { color: rgba(0, 204, 255, 0.19); }

@media (max-width: 900px) {
  .page-body { grid-template-columns: 1fr; }
  .chip-panel { border-right-width: medium; border-right-style: none; border-right-color: currentcolor; border-bottom: 1px solid rgb(26, 42, 54); }
}
