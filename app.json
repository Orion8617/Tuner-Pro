{
  "expo": {
    "name": "GuitarTune",
    "slug": "guitar-tune",
    "version": "1.0.0",
    "description": "The most accurate guitar tuner app. No ads, no bloat, fair price. 10 tunings including Standard, Drop D, DADGAD, Open G, Open D, Open E, Drop C and more. Real-time pitch detection with haptic feedback.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "guitartune",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.guitartune",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "GuitarTune needs microphone access to detect the pitch of your guitar strings for tuning."
      }
    },
    "android": {
      "package": "com.guitartune",
      "permissions": ["RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#0A0A14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
