{
  "expo": {
    "name": "GuitarTune",
    "slug": "juanjose-",
    "version": "1.0.0",
    "description": "The most accurate guitar tuner app. No ads, no bloat, fair price. 10 tunings including Standard, Drop D, DADGAD, Open G, Open D, Open E, Drop C and more. Real-time pitch detection with haptic feedback.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "guitartune",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.guitartune.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "GuitarTune needs microphone access to detect the pitch of your guitar strings for tuning.",
        "NSMicrophoneUsageDescriptionEs": "GuitarTune necesita acceso al micrófono para detectar el tono de tus cuerdas de guitarra.",
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.guitartune.app",
      "versionCode": 1,
      "permissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#0A0A14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "guitartune"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "fa8e48e9-6b78-425f-8a4b-2f24b0247de1"
      }
    }
  }
}
